# AI Scientist Agent Platform — local backend configuration
# Copy to .env and fill in your local service credentials.
# Load explicitly: uv run --env-file .env <command>
# Infrastructure deployment and the public API are still being implemented.

# PostgreSQL: replace CHANGE_ME; percent-encode special password characters.
SCIENTIST_DATABASE_URL=postgresql+psycopg://scientist:CHANGE_ME@127.0.0.1:5432/scientist

# Local MinIO / S3-compatible storage
SCIENTIST_S3_ENDPOINT=http://127.0.0.1:9000
SCIENTIST_OBJECT_BUCKET=scientist
SCIENTIST_S3_ACCESS_KEY=
SCIENTIST_S3_SECRET_KEY=

# Path to a private file containing a generated Fernet encryption key.
# Provision this file before storing provider credentials; keep it out of Git.
SCIENTIST_MASTER_KEY_FILE=.local/secrets/master.key

# A unique random secret of at least 32 bytes for internal broker capabilities.
# Leave empty until provisioned; the broker rejects an empty key.
SCIENTIST_BROKER_CAPABILITY_KEY=

# LLM/tool API keys belong to Settings and encrypted credentials.
# The application does not currently import OPENAI_API_KEY or similar variables.
# Worker bootstrap values and per-run capabilities are managed by the supervisor.
